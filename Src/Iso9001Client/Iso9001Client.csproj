<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>1.0.0</Version>
		<Authors>Sergi Ortiz Gomez</Authors>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<Company>DrUalcman</Company>
		<Description>
			.NET client library for publishing ISO 9001 quality management events to Azure Storage Queues.
			Provides a simple IIso9001 interface to register audit logs, report incidents and errors,
			capture customer feedback, and record non-conformities — all asynchronously via queues.
			Integrates with the .NET dependency injection system and is configured through IOptions.
		</Description>
		<Copyright>Free</Copyright>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/drualcman/Iso9001Client</RepositoryUrl>
		<PackageTags>ISO9001;Quality;AuditLog;Incident;Feedback;NonConformity;Azure;StorageQueues;DependencyInjection</PackageTags>
		<PackageReleaseNotes>First release</PackageReleaseNotes>
		<RepositoryType>Git</RepositoryType>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Azure.Storage.Queues" Version="12.22.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
		<PackageReference Include="Microsoft.Extensions.Options" Version="9.0.0" />
	</ItemGroup>
	<ItemGroup>
		<None Include="..\..\LICENSE.txt">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
</Project>
